num1 = float(input("Enter Float number 1 : "))
num2 = float(input("Enter Float number 2 : "))
num3 = float(input("Enter Float number 3 : "))
sum = num1 + num2 + num3
print()
print("Value number 1 :", num1)
print("Value number 2 :", num2)
print("Value number 3 :", num3)
print("Total all :", sum)
#การใช้ float() เพื่อแปลงค่าที่รับเข้ามาเป็นจำนวนทศนิยม
#การใช้ + เพื่อบวกตัวเลข
